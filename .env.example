# Super Browser Environment Variables
# Copy this file to .env and fill in your values.
# Config.from_env() reads these automatically.

# --- LLM Provider ---
# Required: Your AI provider API key
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: Override the default provider ("anthropic" or "openai")
LLM_PROVIDER=anthropic

# Optional: Override the default model
LLM_MODEL=claude-sonnet-4-20250514

# --- Budget ---
# Maximum daily spend in USD (default: 10.0)
BUDGET_DAILY_CAP_USD=10.0

# --- Browser ---
# Run browser in headless mode (default: true)
HEADLESS=true

# --- Debug ---
# Enable debug mode with screenshots and DOM snapshots
DEBUG=false
